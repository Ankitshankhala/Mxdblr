# =============================================================================
# MXDBLR API — Environment Variables Template
# Copy this file to .env (local) or configure in your hosting dashboard.
# NEVER commit a file containing real secrets to version control.
# =============================================================================

# Server
NODE_ENV=production
PORT=4000

# Database — PostgreSQL connection string
# Railway: copy from the Railway service variables panel
# AWS RDS: postgresql://user:password@rds-endpoint.amazonaws.com:5432/mxdblr_prod
DATABASE_URL=postgresql://user:password@host:5432/mxdblr_prod

# Required only when running `npm run db:seed` — no default password is
# hardcoded in the seed script (security fix, was a known credential in source).
# SEED_ADMIN_PASSWORD=set-a-strong-password-here

# JWT — REQUIRED: app will exit with FATAL error if missing
# Generate: openssl rand -hex 64
JWT_SECRET=REPLACE_WITH_64_CHAR_HEX_SECRET

# Days a dealer stays signed in without visiting (default 90). Each visit renews
# it, so active dealers never need a new login code. Replaces JWT_EXPIRES_IN.
# DEALER_SESSION_DAYS=90

# Dealer session cookie domain, shared by the storefront and the API. Optional:
# when unset it is the API host minus its first label (api.mxdblr.com -> mxdblr.com).
# COOKIE_DOMAIN=mxdblr.com

# MSG91 — dealer login codes, sent on WhatsApp only (no SMS).
# Until all three are set, no code is sent and admins issue login codes by hand.
MSG91_AUTH_KEY=your_msg91_auth_key
# The MSG91 integrated WhatsApp number that sends login codes, e.g. 9198XXXXXXXX.
# Not WHATSAPP_BUSINESS_NUMBER below: that one stays on the Business app.
MSG91_WHATSAPP_NUMBER=your_integrated_whatsapp_number
# Name of the Meta-approved Authentication template (body {{1}} = code, copy-code button).
MSG91_WHATSAPP_OTP_TEMPLATE=your_otp_template_name
# Optional: template language (default en) and namespace, as shown in MSG91.
# MSG91_WHATSAPP_OTP_LANGUAGE=en
# MSG91_WHATSAPP_OTP_NAMESPACE=

# Cloudinary — image uploads
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# WhatsApp Business — the number that receives all dealer inquiries / outbound MSG91 sends.
# Keep this on the WhatsApp Business APP. Registering it on the Cloud API would
# break the manual inquiry inbox; use a SEPARATE number for OTP sending.
WHATSAPP_BUSINESS_NUMBER=919029363910

# Error tracking. Unset by design at launch: 5xx errors go to stderr and PM2 keeps
# them (pm2 logs mxdblr-api). Set this later for alerting -- any Sentry-protocol
# endpoint works, GlitchTip included, with no code change.
SENTRY_DSN=

# =============================================================================
# PRODUCTION BOOT REQUIREMENTS (enforced — see the guard in src/index.ts)
# With NODE_ENV=production the API exits 1 and names every failure unless:
#   - JWT_SECRET is >= 64 chars and not a dev placeholder (openssl rand -hex 32)
#   - ENABLE_OTP_BYPASS is unset
#   - SETTINGS_ENCRYPTION_KEY is set
# SENTRY_DSN is optional: without it error tracking is PM2 logs only -- no alerting,
# no grouping. MSG91_* is optional at launch: WhatsApp login codes need Meta approval, which needs a
# live site. Without it dealers cannot self-register -- admins issue login codes
# from Admin > Dealers. CLOUDINARY_* is optional: without it images are served from local disk (no CDN,
# no auto-optimisation) and api/uploads must be in your backups.
# Each of these fails silently at runtime, so they are checked at startup instead.
# =============================================================================

# =============================================================================
# DEVELOPMENT ONLY — NEVER set in staging or production
# Uncomment locally to bypass OTP verification during development
# =============================================================================
# ENABLE_OTP_BYPASS=true

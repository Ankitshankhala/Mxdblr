# =============================================================================
# MXDBLR web — environment variables template
# Copy to .env.local (local and on the server). NEXT_PUBLIC_* values are built
# into the site at `npm run build`, so rebuild after changing them.
# =============================================================================

# The site's one canonical address, no trailing slash. Metadata, canonical tags,
# sitemap.xml, robots.txt and the www <-> bare-domain redirect all use it.
# Default: https://mxdblr.com (use https://www.mxdblr.com to make www primary).
NEXT_PUBLIC_SITE_URL=https://mxdblr.com

# Public API the browser calls.
NEXT_PUBLIC_API_URL=https://api.mxdblr.com/api

# Optional: API base the web server itself uses for server-side fetches
# (homepage, product pages, sitemap), without /api. Falls back to NEXT_PUBLIC_API_URL.
# INTERNAL_API_URL=http://127.0.0.1:4000

# Must equal the API's JWT_SECRET: proxy.ts verifies admin and dealer tokens with it.
JWT_SECRET=REPLACE_WITH_THE_API_JWT_SECRET

# Business WhatsApp number for wa.me links, without the leading +.
NEXT_PUBLIC_WHATSAPP_NUMBER=919029363910

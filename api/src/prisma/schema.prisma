generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum DealerStatus {
  ACTIVE
  SUSPENDED
  BLOCKED
  REJECTED
}

enum BusinessType {
  RETAIL_SHOP
  WHOLESALER
  DISTRIBUTOR
  REPAIR_SHOP
  ONLINE_SELLER
  MOBILE_ACCESSORIES_STORE
}

enum StockStatus {
  IN_STOCK
  LOW_STOCK
  OUT_OF_STOCK
}

enum NotificationChannel {
  WHATSAPP
  SMS
}

enum InquiryStatus {
  NEW
  VIEWED
  RESPONDED
  CLOSED
}

model Dealer {
  id              String       @id @default(cuid())
  mobile          String       @unique
  ownerName       String
  shopName        String
  whatsappNumber  String
  altMobile       String?
  city            String
  tehsil          String
  district        String
  state           String
  country         String       @default("India")
  pincode         String
  gstNumber       String?
  businessType    BusinessType
  status          DealerStatus @default(ACTIVE)
  lastRevokedAt   DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  cartItems             CartItem[]
  inquiries             InquiryLog[]
  notificationSubs      NotificationSubscription[]
  moderationLogs        ModerationLog[]
}

model OtpCode {
  id        String   @id @default(cuid())
  mobile    String
  code      String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([mobile])
  @@index([expiresAt])
}

model Category {
  id           String     @id @default(cuid())
  name         String
  slug         String     @unique
  description  String     @default("")
  image        String     @default("")
  active       Boolean    @default(true)
  parentId     String?
  parent       Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children     Category[] @relation("CategoryTree")
  displayOrder Int        @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  products     Product[]
  attributeTypes AttributeType[]
}

model AttributeType {
  id          String    @id @default(cuid())
  name        String
  unit        String?
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id])
  attributes  ProductAttribute[]
}

model Product {
  id            String      @id @default(cuid())
  name          String
  brand         String
  sku           String      @unique
  description   String?
  moq           Int         @default(1)
  stockStatus   StockStatus @default(IN_STOCK)
  stockQty      Int         @default(0)
  images        String[]    @default([])
  price          Float?
  pricingActive  Boolean     @default(false)
  // Storefront visibility. false = hidden from the public site but retained in
  // admin (soft-hide instead of delete). Existing rows default to visible.
  active         Boolean     @default(true)
  isNewArrival   Boolean     @default(false)
  isBestSeller   Boolean     @default(false)
  categoryId     String?
  category      Category?   @relation(fields: [categoryId], references: [id])
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  attributes           ProductAttribute[]
  compatibilityTags    CompatibilityTag[]
  features             ProductFeatureLink[]
  cartItems            CartItem[]
  notificationSubs     NotificationSubscription[]
  notificationLogs     NotificationLog[]

  @@index([brand])
  @@index([stockStatus])
  @@index([categoryId])
  @@index([active])
}

model ProductAttribute {
  id              String        @id @default(cuid())
  productId       String
  product         Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  attributeTypeId String
  attributeType   AttributeType @relation(fields: [attributeTypeId], references: [id])
  value           String
}

// Category buckets for the Product Feature master list. Drives grouping on the
// product detail "Supported Technologies" section.
enum ProductFeatureCategory {
  CHARGING       // fast-charge protocols: Quick Charge, PD, VOOC, SuperVOOC…
  WIRELESS       // Qi, MagSafe
  CABLE          // USB-C, Lightning, Thunderbolt, USB 3.x/4
  DATA           // transfer speeds: 480Mbps, 5/10/20/40 Gbps
  PROTECTION     // over-voltage/current, short-circuit, temperature
  CERTIFICATION  // CE, FCC, RoHS, BIS
}

// Which media a feature renders with. ICON = the small logo/glyph (default,
// what products show on cards); IMAGE = the larger photo/banner; BOTH = show both.
enum FeatureDisplayMode {
  ICON
  IMAGE
  BOTH
}

// Master list of supported technologies a product can advertise (fast-charge
// standards, cable types, certifications). Central so 400+ products reference a
// feature by slug instead of each uploading a duplicate logo image. `logo` is the
// ICON (public path under web/public/product-features/<slug>.svg, an uploaded
// Cloudinary/local URL, or a data-URI SVG); `image` is the optional larger photo.
// `displayMode` chooses icon-only / image-only / both.
model ProductFeature {
  id           String                 @id @default(cuid())
  name         String
  slug         String                 @unique
  logo         String                 @default("")
  image        String                 @default("")
  displayMode  FeatureDisplayMode     @default(ICON)
  category     ProductFeatureCategory @default(CHARGING)
  description  String                 @default("")
  active       Boolean                @default(true)
  displayOrder Int                    @default(0)
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  products     ProductFeatureLink[]

  @@index([category])
  @@index([active])
}

// Join table: which features a product supports. Ordered per-product so admins
// control which icons surface first on the (max-4) card.
model ProductFeatureLink {
  id           String         @id @default(cuid())
  productId    String
  product      Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  featureId    String
  feature      ProductFeature @relation(fields: [featureId], references: [id], onDelete: Cascade)
  displayOrder Int            @default(0)

  @@unique([productId, featureId])
  @@index([productId])
  @@index([featureId])
}

model CompatibilityTag {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag       String
}

model CartItem {
  id        String   @id @default(cuid())
  dealerId  String
  dealer    Dealer   @relation(fields: [dealerId], references: [id])
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([dealerId, productId])
}

model InquiryLog {
  id             String        @id @default(cuid())
  dealerId       String
  dealer         Dealer        @relation(fields: [dealerId], references: [id])
  cartSnapshot   Json          @default("[]")
  whatsappSentAt DateTime      @default(now())
  status         InquiryStatus @default(NEW)
  createdAt      DateTime      @default(now())
}

model NotificationSubscription {
  id          String   @id @default(cuid())
  dealerId    String?
  dealer      Dealer?  @relation(fields: [dealerId], references: [id])
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  phoneNumber String
  createdAt   DateTime @default(now())

  @@unique([phoneNumber, productId])
}

model NotificationLog {
  id             String              @id @default(cuid())
  productId      String
  product        Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  recipientPhone String
  channel        NotificationChannel
  message        String
  status         String              @default("sent")
  sentAt         DateTime            @default(now())
}

model GeoRestriction {
  id        String   @id @default(cuid())
  state     String
  district  String   @default("")
  allowed   Boolean  @default(true)
  updatedBy String?
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@unique([state, district])
}

model AdminUser {
  id             String    @id @default(cuid())
  username       String    @unique
  passwordHash   String
  active         Boolean   @default(true)
  // Authorization is derived server-side from this role's permissions — never from
  // client input. A null role grants no admin permissions (locked out by default).
  roleId         String?
  role           Role?     @relation(fields: [roleId], references: [id])
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  moderationLogs ModerationLog[]
  auditLogs      AuditLog[] @relation("AuditActor")

  @@index([roleId])
}

model ModerationLog {
  id        String    @id @default(cuid())
  dealerId  String
  dealer    Dealer    @relation(fields: [dealerId], references: [id])
  action    String
  adminId   String
  admin     AdminUser @relation(fields: [adminId], references: [id])
  reason    String?
  createdAt DateTime  @default(now())
}

// ── RBAC (Role-Based Access Control) ──────────────────────────────────────────
// Fixed catalog of permissions. New permission types are added here in code (a
// schema change), not by users at runtime. Super Admin assigns these to roles.
enum Permission {
  VIEW_DASHBOARD
  MANAGE_PRODUCTS
  MANAGE_INVENTORY
  CREATE_ORDERS
  EDIT_ORDERS
  VIEW_REPORTS
  MANAGE_STAFF
  MANAGE_CUSTOMERS
  ACCESS_FINANCIAL_DATA
  SYSTEM_SETTINGS
  MANAGE_ROLES   // create/edit/delete roles and their permissions (Super Admin)
  MANAGE_ADMINS  // create/manage admin-level accounts (Super Admin)
}

// Roles are dynamic: Super Admin can create/delete custom roles beyond the four
// system roles. `rank` drives the anti-privilege-escalation guard (lower = more
// privileged; SUPER_ADMIN = 0). `isSystem` roles cannot be deleted or renamed.
model Role {
  id          String           @id @default(cuid())
  name        String           @unique
  description String           @default("")
  isSystem    Boolean          @default(false)
  rank        Int              @default(100)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  permissions RolePermission[]
  users       AdminUser[]
}

model RolePermission {
  id         String     @id @default(cuid())
  roleId     String
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission

  @@unique([roleId, permission])
  @@index([roleId])
}

enum AuditAction {
  ROLE_CREATED
  ROLE_UPDATED
  ROLE_PERMISSIONS_UPDATED
  ROLE_DELETED
  USER_CREATED
  USER_ROLE_CHANGED
  USER_ACTIVATED
  USER_DEACTIVATED
  USER_DELETED
}

// Immutable audit trail for every role/permission/user change (Security req #6).
// actorName/targetName are denormalized so the log survives actor/target deletion.
model AuditLog {
  id         String      @id @default(cuid())
  actorId    String?
  actor      AdminUser?  @relation("AuditActor", fields: [actorId], references: [id])
  actorName  String
  action     AuditAction
  targetType String
  targetId   String?
  targetName String      @default("")
  details    Json        @default("{}")
  createdAt  DateTime    @default(now())

  @@index([createdAt])
  @@index([action])
}

enum BannerType {
  SIMPLE
  PRODUCT_PROMO
  BRAND_PROMO
}

model Brand {
  id           String   @id @default(cuid())
  name         String   @unique
  slug         String   @unique
  logo         String   @default("")
  active       Boolean  @default(true)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model SystemSettings {
  id                  Int      @id @default(1)
  whatsappNumber      String   @default("")
  msg91ApiKey         String   @default("")
  cloudinaryCloud     String   @default("")
  cloudinaryApiKey    String   @default("")
  cloudinaryApiSecret String   @default("")
  updatedAt           DateTime @updatedAt
}

model Banner {
  id            String     @id @default(cuid())
  bannerType    BannerType @default(SIMPLE)
  title         String
  subtitle      String     @default("")
  ctaText       String     @default("Browse Catalog")
  ctaLink       String     @default("/catalog")
  image         String     @default("")
  mobileImage   String     @default("")
  bgColor       String     @default("#1A1A2E")
  accentColor   String     @default("#F47920")
  logoImage     String     @default("")
  productImage1 String     @default("")
  productImage2 String     @default("")
  productImage3 String     @default("")
  overlayOpacity Float     @default(0.35)
  textAlignment String     @default("left")
  active        Boolean    @default(true)
  displayOrder  Int        @default(0)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}

// Scrolling announcement bar messages shown on the home page marquee.
// Admin-editable via /admin/announcements.
model Announcement {
  id           String   @id @default(cuid())
  text         String
  active       Boolean  @default(true)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Categorises an Event for the homepage "Events & Activities" section badge.
enum EventCategory {
  PRODUCT_LAUNCH
  DEALER_MEETUP
  TRAINING
  EXHIBITION
  CELEBRATION
  OTHER
}

// "Events & Activities" — marketing/trust content shown on the homepage above
// "Why Dealers Choose MXD" and managed via /admin/events. Follows the existing
// content-model convention (single model, String[] media, published/featured/
// displayOrder) rather than separate image/video tables.
//
// `videos` is a JSON array of { url, thumbnailUrl, source } where source is one of
// 'youtube' | 'vimeo' | 'upload' | 'url'. Uploaded videos store a Cloudinary-derived
// poster in thumbnailUrl; YouTube videos derive it from the video id; others fall
// back to the HTML5 <video> first frame on the client.
model Event {
  id           String        @id @default(cuid())
  title        String
  description  String        @default("")
  category     EventCategory @default(OTHER)
  eventDate    DateTime
  location     String        @default("")
  coverImage   String        @default("")
  images       String[]      @default([])
  videos       Json          @default("[]")
  published    Boolean       @default(false)
  featured     Boolean       @default(false)
  displayOrder Int           @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  // Public feed query is WHERE published ORDER BY displayOrder asc, eventDate desc, id.
  @@index([published, displayOrder, eventDate])
}

# =============================================================================
# MXDBLR Web — Multi-stage Dockerfile (Next.js standalone output)
# Requires next.config.ts to have output: 'standalone'
# Stage 1 (deps):  production dependencies
# Stage 2 (build): full build → .next/standalone + .next/static
# Stage 3 (runner): minimal image — runs Next.js standalone server
# =============================================================================

FROM node:20-alpine AS base
WORKDIR /app

# ── Stage 1: production dependencies only ────────────────────────────────────
FROM base AS deps
COPY package.json package-lock.json ./
RUN npm ci --only=production

# ── Stage 2: full build ───────────────────────────────────────────────────────
FROM base AS build
COPY package.json package-lock.json ./
RUN npm ci
COPY . .

# NEXT_PUBLIC_* vars are baked into the browser bundle at build time —
# must be passed as build args, not runtime env (runtime env has no effect
# on already-compiled client JS).
ARG NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL}

# Optional build-time values. Left empty, the components that read them
# self-suppress (TrustStats hides, WhatsApp falls back to lib/config.ts).
ARG NEXT_PUBLIC_WHATSAPP_NUMBER
ENV NEXT_PUBLIC_WHATSAPP_NUMBER=${NEXT_PUBLIC_WHATSAPP_NUMBER}
ARG NEXT_PUBLIC_STAT_DEALERS
ENV NEXT_PUBLIC_STAT_DEALERS=${NEXT_PUBLIC_STAT_DEALERS}
ARG NEXT_PUBLIC_STAT_SKUS
ENV NEXT_PUBLIC_STAT_SKUS=${NEXT_PUBLIC_STAT_SKUS}

RUN npm run build

# ── Stage 3: lean runner ──────────────────────────────────────────────────────
FROM base AS runner
ENV NODE_ENV=production
WORKDIR /app

# Create non-root user — never run containers as root
RUN addgroup --system --gid 1001 nodejs
RUN adduser --system --uid 1001 nextjs

# Static assets — served directly from the container
COPY --from=build /app/public ./public

# Next.js standalone build output
COPY --from=build --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=build --chown=nextjs:nodejs /app/.next/static ./.next/static

USER nextjs

EXPOSE 3000
ENV PORT=3000

# server.js is generated by Next.js standalone output
CMD ["node", "server.js"]

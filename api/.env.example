# =============================================================================
# MXDBLR API — Environment Variables Template
# Copy this file to .env (local) or configure in your hosting dashboard.
# NEVER commit a file containing real secrets to version control.
# =============================================================================

# Server
NODE_ENV=production
PORT=4000

# Database — PostgreSQL connection string
# Railway: copy from the Railway service variables panel
# AWS RDS: postgresql://user:password@rds-endpoint.amazonaws.com:5432/mxdblr_prod
DATABASE_URL=postgresql://user:password@host:5432/mxdblr_prod

# JWT — REQUIRED: app will exit with FATAL error if missing
# Generate: openssl rand -hex 64
JWT_SECRET=REPLACE_WITH_64_CHAR_HEX_SECRET

# Token expiry (default: 7d)
JWT_EXPIRES_IN=7d

# Settings Encryption — used when encrypting sensitive settings stored in DB
# Generate: openssl rand -hex 32
# Must match across all API instances in a cluster
SETTINGS_ENCRYPTION_KEY=REPLACE_WITH_32_CHAR_HEX_KEY

# MSG91 — OTP delivery
MSG91_AUTH_KEY=your_msg91_auth_key
MSG91_TEMPLATE_ID=your_otp_template_id
MSG91_SENDER_ID=MXDBLR

# Cloudinary — image uploads
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# WhatsApp Business
WHATSAPP_BUSINESS_NUMBER=919XXXXXXXXXX

# =============================================================================
# DEVELOPMENT ONLY — NEVER set in staging or production
# Uncomment locally to bypass OTP verification during development
# =============================================================================
# ENABLE_OTP_BYPASS=true
